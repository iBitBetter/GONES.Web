@model GONES.Web.Models.WorkerEditViewModel
@{
    ViewBag.Title = Model.ID > 0 ? "人员编辑" : "新建人员";
    bool isEdit = Model.ID > 0;
}
<div class="row justify-content-center">
    <div class="col-xl-8">
        <form class="card" asp-action="@(isEdit ? "Edit" : "Create")"
              asp-route-id="@(isEdit ? (int?)Model.ID : null)" method="post" autocomplete="off">
            @if (isEdit)
            {
                <input type="hidden" asp-for="ID" />
            }
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label required" asp-for="Name">姓名</label>
                        <input asp-for="Name" class="form-control" placeholder="请输入姓名" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label required" asp-for="DepID">所属部门</label>
                        <select asp-for="DepID" class="form-select">
                            <option value="">请选择部门…</option>
                            @foreach (var d in (System.Collections.Generic.List<GONES.Web.Models.DepartmentNode>)ViewBag.DepOptions)
                            {
                                <option value="@d.Id" disabled="@(!d.Enabled)">@d.Name</option>
                            }
                        </select>
                        <span asp-validation-for="DepID" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="Mobile">手机号</label>
                        <input asp-for="Mobile" class="form-control" placeholder="请输入手机号" />
                        <span asp-validation-for="Mobile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="IDNumber">身份证号</label>
                        <input asp-for="IDNumber" class="form-control" placeholder="15 或 18 位，末位可为 X" />
                        <span asp-validation-for="IDNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input asp-for="Status" class="form-check-input" type="checkbox" />
                        <span class="form-check-label">启用</span>
                    </label>
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
            <div class="card-footer">
                <div class="btn-list justify-content-end">
                    <a class="btn" href="/PmsWorker">关闭(C)</a>
                    <button type="submit" class="btn btn-primary">保存(S)</button>
                </div>
            </div>
        </form>
    </div>
</div>
