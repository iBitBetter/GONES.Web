@model System.Collections.Generic.List<GONES.Model.Pg.t_ERP_ITEM>
@{
    ViewBag.Title = "商品管理";
    var classNames = (System.Collections.Generic.Dictionary<int, string>)ViewBag.ClassNames;
    var tree = (System.Collections.Generic.List<GONES.Web.Models.ItemClassNode>)ViewBag.Tree;
    int currentClassId = (int)ViewBag.CurrentClassId;
    string currentClassName = (string)ViewBag.CurrentClassName;
    var filter = (System.Collections.Generic.Dictionary<string, string>)ViewBag.Filter;
    bool showStopped = (bool)ViewBag.ShowStopped;
    bool showUnpublished = (bool)ViewBag.ShowUnpublished;

    // 树状菜单默认展开集合：选中分类时展开其祖先链；未选中时展开全部一级节点
    var expandedIds = new System.Collections.Generic.HashSet<int>();
    CollectExpandPath(tree, currentClassId, expandedIds);
    if (currentClassId == 0)
    {
        foreach (var root in tree) { expandedIds.Add(root.Id); }
    }
    ViewBag.ExpandedIds = expandedIds;
}
@functions {
    // 递归查找 target 所在路径，把沿途祖先节点 id 收进 expanded；找到返回 true
    static bool CollectExpandPath(System.Collections.Generic.List<GONES.Web.Models.ItemClassNode> nodes, int target, System.Collections.Generic.HashSet<int> expanded)
    {
        foreach (var n in nodes)
        {
            if (n.Id == target || CollectExpandPath(n.Children, target, expanded))
            {
                expanded.Add(n.Id);
                return true;
            }
        }
        return false;
    }
}
<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            <a class="btn btn-primary" href="/PmsItem/Create@(currentClassId > 0 ? "?classId=" + currentClassId : "")" data-item-create>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                    <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                </svg>
                新建
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="row g-3">
    <!-- 左侧：商品分类树状菜单，点击节点按分类（含子分类）过滤，箭头展开/折叠 -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">商品分类</h3>
            </div>
            <div class="card-body py-2">
                <ul class="item-tree list-unstyled mb-0">
                    <li class="tree-node">
                        <div class="tree-item @(currentClassId == 0 ? "active" : "")">
                            <span class="tree-toggle-placeholder"></span>
                            <a class="tree-link" href="/PmsItem">所有分类</a>
                        </div>
                    </li>
                    @foreach (var node in tree)
                    {
                        @await Html.PartialAsync("_TreeNode", node)
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- 右侧：商品列表 -->
    <div class="col-lg-9">
        <div class="card mb-3">
            <div class="card-body py-2">
                <form method="get" class="row g-2 align-items-end">
                    @if (currentClassId > 0)
                    {
                        <input type="hidden" name="classId" value="@currentClassId" />
                    }
                    <div class="col">
                        <label class="form-label mb-0">编码</label>
                        <input class="form-control form-control-sm" name="cpbm" value="@filter["cpbm"]" />
                    </div>
                    <div class="col">
                        <label class="form-label mb-0">简称</label>
                        <input class="form-control form-control-sm" name="cpjc" value="@filter["cpjc"]" />
                    </div>
                    <div class="col">
                        <label class="form-label mb-0">规格</label>
                        <input class="form-control form-control-sm" name="cpgg" value="@filter["cpgg"]" />
                    </div>
                    <div class="col">
                        <label class="form-label mb-0">条码</label>
                        <input class="form-control form-control-sm" name="txm" value="@filter["txm"]" />
                    </div>
                    <div class="col-auto">
                        <label class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="showStopped" value="true" @(showStopped ? "checked" : "") />
                            <span class="form-check-label">显示停用</span>
                        </label>
                        <label class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="showUnpublished" value="true" @(showUnpublished ? "checked" : "") />
                            <span class="form-check-label">显示未发布</span>
                        </label>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">查询</button>
                        <a class="btn btn-sm btn-outline-secondary" href="/PmsItem">清空</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>编码</th>
                            <th>简称</th>
                            <th>规格</th>
                            <th>条码</th>
                            <th>分类</th>
                            <th>零售价</th>
                            <th>状态</th>
                            <th class="w-1">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr class="@(i.IsEnabled != true ? "table-warning" : "")">
                                <td class="text-nowrap">@i.ItemCode</td>
                                <td>@i.ItemShortName</td>
                                <td>@(string.IsNullOrWhiteSpace(i.ItemSpec) ? "-" : i.ItemSpec)</td>
                                <td class="text-nowrap">@(string.IsNullOrWhiteSpace(i.Barcode) ? "-" : i.Barcode)</td>
                                <td>@(i.CategoryId.HasValue && classNames.ContainsKey(i.CategoryId.Value) ? classNames[i.CategoryId.Value] : "-")</td>
                                <td>@(i.RetailPrice?.ToString("0.00") ?? "-")</td>
                                <td>
                                    @if (i.IsEnabled != true)
                                    {
                                        <span class="badge bg-secondary-lt">停用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-green-lt">启用</span>
                                    }
                                    @if (i.IsPublishControlled != true)
                                    {
                                        <span class="badge bg-azure-lt ms-1">未发布</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-item-edit="@i.ID">修改</button>
                                        @if (i.IsEnabled != true)
                                        {
                                            <form asp-action="ToggleStop" asp-route-id="@i.ID" method="post" class="d-inline">
                                                <input type="hidden" name="stop" value="false" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">启用</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleStop" asp-route-id="@i.ID" method="post" class="d-inline"
                                                  data-confirm=""
                                                  data-confirm-title="停用商品"
                                                  data-confirm-message="确定停用商品“@i.ItemShortName”吗？"
                                                  data-confirm-yes="确定停用"
                                                  data-confirm-yes-class="btn-warning">
                                                <input type="hidden" name="stop" value="true" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">停用</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Count == 0)
            {
                <div class="card-body text-center text-secondary py-5">
                    暂无符合条件的商品。
                </div>
            }
            @await Html.PartialAsync("_Pager", (GONES.Web.Models.PagerViewModel)ViewBag.Pager)
        </div>
    </div>
</div>

<!-- 商品新增/修改模态窗体 -->
<div class="modal modal-blur fade" id="itemModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body" id="itemModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ---- 左侧分类树状菜单 ---- */
        .item-tree, .item-tree ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .item-tree .tree-children {
            margin-left: 1.05rem;
            padding-left: .35rem;
            border-left: 1px dashed var(--tblr-border-color, #e0e6ee);
        }
        .item-tree .tree-item {
            display: flex;
            align-items: center;
            gap: .1rem;
            border-radius: .35rem;
            padding: .3rem .4rem;
            margin: .1rem 0;
            color: var(--tblr-body-color, #1e293b);
        }
        .item-tree .tree-item:hover {
            background: var(--tblr-active-bg, rgba(32,107,196,.06));
        }
        .item-tree .tree-item.active {
            background: var(--tblr-primary, #206bc4);
        }
        .item-tree .tree-item.active .tree-link {
            color: #fff;
            font-weight: 600;
        }
        .item-tree .tree-item.active .tree-toggle {
            color: #fff;
        }
        .item-tree .tree-link {
            flex: 1 1 auto;
            color: inherit;
            text-decoration: none;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .item-tree .tree-toggle,
        .item-tree .tree-toggle-placeholder {
            flex: 0 0 1.25rem;
            width: 1.25rem;
            height: 1.25rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .item-tree .tree-toggle {
            border: 0;
            background: transparent;
            padding: 0;
            color: var(--tblr-secondary, #6c757d);
            border-radius: .25rem;
        }
        .item-tree .tree-toggle:hover {
            background: var(--tblr-border-color, #e0e6ee);
        }
        .item-tree .tree-toggle svg {
            transition: transform .15s ease;
        }
        .item-tree .tree-toggle.open svg {
            transform: rotate(90deg);
        }
    </style>
    <script>
    (function () {
        var modalEl = document.getElementById('itemModal');
        var body = document.getElementById('itemModalBody');
        var titleEl = document.getElementById('itemModalTitle');

        // 经 innerHTML 注入的 <script> 浏览器不会自动执行，这里手动重跑，
        // 使部分视图里的表单交互（拼音/组合明细/条码必填联动）在模态框内生效。
        function runScripts(container) {
            var nodes = container.querySelectorAll('script');
            Array.prototype.forEach.call(nodes, function (old) {
                var s = document.createElement('script');
                s.textContent = old.textContent;
                document.body.appendChild(s);
                if (s.parentNode) s.parentNode.removeChild(s);
            });
        }

        function openItemModal(url, title) {
            titleEl.textContent = title || '';
            body.innerHTML = '<div class="text-center text-secondary py-5">加载中…</div>';
            var inst = bootstrap.Modal.getOrCreateInstance(modalEl);
            inst.show();
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    body.innerHTML = html;
                    runScripts(body);
                    bindFormSubmit(body);
                })
                .catch(function () {
                    body.innerHTML = '<div class="alert alert-danger">加载失败，请重试。</div>';
                });
        }

        // 局部刷新右侧列表：重新 GET 当前 Index（带原始查询串，保持筛选/分页），
        // 仅抽取 .col-lg-9 内容替换，避免整页刷新闪动；左侧分类树与"新建"按钮不受影响。
        function refreshList() {
            fetch(window.location.pathname + window.location.search, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(function (r) { return r.text(); }).then(function (html) {
                var tmp = document.createElement('div');
                tmp.innerHTML = html;
                var src = tmp.querySelector('.col-lg-9');
                var dst = document.querySelector('.col-lg-9');
                if (src && dst) {
                    dst.innerHTML = src.innerHTML;
                    dst.querySelectorAll('[data-item-edit]').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            openItemModal('/PmsItem/Edit/' + this.getAttribute('data-item-edit'), '修改商品');
                        });
                    });
                } else {
                    location.reload();   // 兜底：抽不到列表区域则退回整页刷新
                }
            }).catch(function () { location.reload(); });
        }

        function onSaved(d) {
            var inst = bootstrap.Modal.getOrCreateInstance(modalEl);
            inst.hide();
            if (window.gonesToast) window.gonesToast(d && d.msg ? d.msg : '保存成功');
            refreshList();
        }

        function bindFormSubmit(container) {
            var form = container.querySelector('form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var fd = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: fd
                }).then(function (r) {
                    if (r.ok) {
                        return r.json().then(function (d) { onSaved(d); });
                    }
                    // 校验失败：服务端返回 400 + 带验证错误的 partial，整体替换回显
                    return r.text().then(function (html) {
                        container.innerHTML = html;
                        runScripts(container);
                        bindFormSubmit(container);
                    });
                }).catch(function () {
                    /* 网络异常：保留已填内容，不破坏表单 */
                });
            });
        }

        document.querySelectorAll('[data-item-edit]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openItemModal('/PmsItem/Edit/' + this.getAttribute('data-item-edit'), '修改商品');
            });
        });

        // 「新建」同样走模态窗体（与修改一致），href 保留作非 JS 兜底/新标签打开
        document.querySelectorAll('[data-item-create]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                openItemModal(this.getAttribute('href'), '新建商品');
            });
        });

        // 左侧分类树：事件委托（含子孙节点），点箭头展开/折叠，点名称仍按分类过滤
        var treeRoot = document.querySelector('.item-tree');
        if (treeRoot) {
            treeRoot.addEventListener('click', function (e) {
                var t = e.target.closest('.tree-toggle');
                if (!t) return;
                e.preventDefault();
                var li = t.closest('.tree-node');
                var childUl = li ? li.querySelector(':scope > .tree-children') : null;
                if (!childUl) return;
                var nowOpen = childUl.classList.toggle('d-none') === false;
                t.classList.toggle('open', nowOpen);
                t.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
            });
        }
    })();
    </script>
}
