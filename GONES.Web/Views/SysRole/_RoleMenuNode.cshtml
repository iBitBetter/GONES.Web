@model GONES.Web.Models.RoleMenuNode

<li>
    <label class="form-check">
        <input type="checkbox" class="form-check-input" name="menuIds" value="@Model.Id"
               @(Model.Checked ? "checked" : "") />
        <span class="form-check-label">@Model.Name</span>
    </label>
    @if (Model.Children.Any())
    {
        <ul class="list-unstyled ms-4">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_RoleMenuNode", child)
            }
        </ul>
    }
</li>
