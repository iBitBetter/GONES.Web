@model GONES.Web.Models.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "修改密码";
    bool forced = ViewBag.Forced is bool f && f;
}
<div class="text-center mb-4">
    <h1 class="navbar-brand navbar-brand-autodark fs-2">GONES 管理系统</h1>
</div>
<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">修改密码</h2>

        @if (forced)
        {
            <div class="alert alert-warning" role="alert">
                您当前使用的是系统分配的<strong>初始密码</strong>，为保障账户安全，请先修改为您的个人密码后再继续使用。
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-action="ChangePassword" method="post" autocomplete="off" id="ChangePasswordForm" novalidate>
            <div class="mb-3">
                <label class="form-label" asp-for="OldPassword">当前密码</label>
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z" />
                            <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" />
                            <path d="M8 11v-4a4 4 0 1 1 8 0v4" />
                        </svg>
                    </span>
                    <input asp-for="OldPassword" type="password" class="form-control" placeholder="请输入当前密码" autofocus />
                </div>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="NewPassword">新密码</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="8-32 位，建议含字母与数字" minlength="8" maxlength="32" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword">确认新密码</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="请再次输入新密码" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@Html.ValidationSummary(false)</div>
            }
            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">修改密码</button>
            </div>
        </form>
    </div>
</div>
<p class="text-secondary text-center mt-3 mb-0">
    密码长度 8-32 位，建议同时包含字母与数字。
</p>

@* ===== 客户端校验失败时的友好弹窗提醒（零依赖，原生 JS） ===== *@
<div id="PwdAlertOverlay" style="display:none; position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,.35); align-items:center; justify-content:center;">
    <div class="card card-md" style="width:22rem; animation:pwdPop .18s ease-out;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="avatar avatar-sm bg-warning-lt me-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 9v4m0 4h.01" /><path d="M10.24 3.957l-8.422 14.06a1.98 1.98 0 0 0 1.7 2.983h16.845a1.98 1.98 0 0 0 1.7 -2.983l-8.423 -14.06a1.98 1.98 0 0 0 -3.4 0z" />
                    </svg>
                </span>
                <h3 class="card-title mb-0">请检查输入</h3>
            </div>
            <div id="PwdAlertBody" class="text-secondary"></div>
            <div class="mt-3">
                <button type="button" id="PwdAlertClose" class="btn btn-primary w-100">知道了</button>
            </div>
        </div>
    </div>
</div>
<style>
    @@keyframes pwdPop { from { transform: scale(.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>
<script>
(function () {
    var form = document.getElementById('ChangePasswordForm');
    if (!form) return;

    var overlay = document.getElementById('PwdAlertOverlay');
    var alertBody = document.getElementById('PwdAlertBody');
    var alertClose = document.getElementById('PwdAlertClose');

    function field(name) { return form.querySelector('[name="' + name + '"]'); }
    function msgSpan(name) { return form.querySelector('[data-valmsg-for="' + name + '"]'); }

    function showPopup(errors, firstBad) {
        alertBody.innerHTML = '';
        if (errors.length === 1) {
            alertBody.textContent = errors[0];
        } else {
            var ul = document.createElement('ul');
            ul.className = 'mb-0 ps-3';
            errors.forEach(function (t) {
                var li = document.createElement('li'); li.textContent = t; ul.appendChild(li);
            });
            alertBody.appendChild(ul);
        }
        overlay.style.display = 'flex';
        if (firstBad) firstBad.focus();
    }
    function hidePopup() { overlay.style.display = 'none'; }
    alertClose.addEventListener('click', hidePopup);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) hidePopup(); });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.style.display !== 'none') hidePopup();
    });

    // 输入即清除该字段的错误标记
    ['OldPassword', 'NewPassword', 'ConfirmPassword'].forEach(function (n) {
        var el = field(n);
        if (el) el.addEventListener('input', function () {
            el.classList.remove('is-invalid');
            var sp = msgSpan(n); if (sp) sp.textContent = '';
        });
    });

    form.addEventListener('submit', function (e) {
        var errors = [], firstBad = null;
        function bad(name, msg) {
            var el = field(name);
            errors.push(msg);
            if (el) {
                el.classList.add('is-invalid');
                var sp = msgSpan(name); if (sp) sp.textContent = msg;
                if (!firstBad) firstBad = el;
            }
        }

        var old = field('OldPassword'), pwd = field('NewPassword'), confirm = field('ConfirmPassword');
        if (!old.value) bad('OldPassword', '请输入当前密码');
        if (!pwd.value) {
            bad('NewPassword', '请输入新密码');
        } else if (pwd.value.length < 8 || pwd.value.length > 32) {
            bad('NewPassword', '新密码长度为 8-32 位，当前 ' + pwd.value.length + ' 位');
        }
        if (!confirm.value) {
            bad('ConfirmPassword', '请再次输入新密码');
        } else if (pwd.value && confirm.value !== pwd.value) {
            bad('ConfirmPassword', '两次输入的新密码不一致');
        }

        if (errors.length > 0) {
            e.preventDefault();
            showPopup(errors, firstBad);
        }
        // 全部通过则放行，由服务端二次校验（旧密码是否正确等）
    });
})();
</script>
