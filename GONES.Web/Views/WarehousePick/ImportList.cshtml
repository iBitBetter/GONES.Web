@using GONES.Web.Models
@model List<BillUseImportRow>
@{
    ViewBag.Title = "从领料申请单导入";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            <a class="btn btn-outline-secondary" href="/WarehousePick">返回列表</a>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header"><h3 class="card-title">领料申请单</h3></div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-sm">
            <thead>
                <tr>
                    <th>申请单号</th>
                    <th>日期</th>
                    <th>领用部门</th>
                    <th>可导入原料行</th>
                    <th class="w-1">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">暂无领料申请单。</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.FBillNo</td>
                        <td class="text-secondary">@r.FDate?.ToString("yyyy/M/d")</td>
                        <td>@r.DeptName</td>
                        <td>@r.RawCount</td>
                        <td>
                            @if (r.RawCount > 0)
                            {
                                <a class="btn btn-sm btn-primary" href="/WarehousePick/ImportFromBillUse/@r.FInterID">导入</a>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">无可导入行</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
