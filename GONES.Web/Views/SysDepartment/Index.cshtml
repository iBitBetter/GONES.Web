@model System.Collections.Generic.List<GONES.Model.Pg.t_ERP_Department>
@{
    ViewBag.Title = "部门管理";
    var tree = (System.Collections.Generic.List<GONES.Web.Models.DepartmentNode>)ViewBag.Tree;
    var path = (System.Collections.Generic.List<t_ERP_Department>)ViewBag.Path;
    int currentId = (int)ViewBag.CurrentId;

    // 树状菜单默认展开集合：选中部门时展开其祖先链；未选中(根)时展开全部一级节点
    var depExpanded = new System.Collections.Generic.HashSet<int>();
    CollectExpandPath(tree, currentId, depExpanded);
    if (currentId == 0) { foreach (var r in tree) depExpanded.Add(r.Id); }
    ViewBag.DepExpandedIds = depExpanded;
    ViewBag.DepTreeBaseUrl = "/SysDepartment";
    ViewBag.DepTreeParam = "pid";
    ViewBag.CurrentDepId = currentId;
}
@functions {
    static bool CollectExpandPath(System.Collections.Generic.List<GONES.Web.Models.DepartmentNode> nodes, int target, System.Collections.Generic.HashSet<int> expanded)
    {
        foreach (var n in nodes)
        {
            if (n.Id == target || CollectExpandPath(n.Children, target, expanded))
            {
                expanded.Add(n.Id);
                return true;
            }
        }
        return false;
    }
}
@if (path.Count > 0)
{
    <ol class="breadcrumb mb-3">
        @for (int i = 0; i < path.Count; i++)
        {
            if (i == path.Count - 1)
            {
                <li class="breadcrumb-item active">@path[i].DEPName</li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a href="/SysDepartment?pid=@path[i].ID">@path[i].DEPName</a>
                </li>
            }
        }
    </ol>
}

<div class="row g-3">
    <!-- 左侧：部门架构树状菜单 -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">部门架构</h3>
            </div>
            <div class="card-body py-2">
                <ul class="item-tree list-unstyled mb-0">
                    @foreach (var node in tree)
                    {
                        @await Html.PartialAsync("_DepTreeNode", node)
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- 右侧：下级部门列表 -->
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">下级部门列表</h3>
                <div class="card-actions">
                    <a class="btn btn-primary" href="/SysDepartment/Create?pid=@currentId">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                            <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                        </svg>
                        新建
                    </a>
                </div>
            </div>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger m-3 mb-0">@TempData["Error"]</div>
            }
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th class="w-1">ID</th>
                            <th>部门名称</th>
                            <th>类型</th>
                            <th>状态</th>
                            <th class="w-1">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-4">
                                    该部门下暂无下级部门，点击右上角"新建"添加。
                                </td>
                            </tr>
                        }
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td class="text-secondary">@d.ID</td>
                                <td>
                                    <a href="/SysDepartment?pid=@d.ID">@d.DEPName</a>
                                </td>
                                <td>
                                    @if (d.IsDEP == 2)
                                    {
                                        <span class="badge bg-azure-lt">车间</span>
                                    }
                                    else if (d.IsDEP == 1)
                                    {
                                        <span class="badge bg-orange-lt">仓库</span>
                                    }
                                    else if (d.IsDEP == 3)
                                    {
                                        <span class="badge bg-teal-lt">班组</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-grey-lt">部门</span>
                                    }
                                </td>
                                <td>
                                    @if (d.Status == 1)
                                    {
                                        <span class="badge bg-green-lt">启用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-red-lt">停用</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        <a class="btn btn-sm" href="/SysDepartment/Edit/@d.ID">修改</a>
                                        <form asp-action="Delete" asp-route-id="@d.ID" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    data-confirm
                                                    data-confirm-title="删除部门"
                                                    data-confirm-message="确定删除部门“@d.DEPName”吗？"
                                                    data-confirm-yes="删除"
                                                    data-confirm-yes-class="btn-danger">删除</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* 左侧部门架构树状菜单（同 PmsItem 商品分类树） */
        .item-tree, .item-tree ul { list-style: none; margin: 0; padding: 0; }
        .item-tree .tree-children { margin-left: 1.05rem; padding-left: .35rem; border-left: 1px dashed var(--tblr-border-color, #e0e6ee); }
        .item-tree .tree-item { display: flex; align-items: center; gap: .1rem; border-radius: .35rem; padding: .3rem .4rem; margin: .1rem 0; color: var(--tblr-body-color, #1e293b); }
        .item-tree .tree-item:hover { background: var(--tblr-active-bg, rgba(32,107,196,.06)); }
        .item-tree .tree-item.active { background: var(--tblr-primary, #206bc4); }
        .item-tree .tree-item.active .tree-link { color: #fff; font-weight: 600; }
        .item-tree .tree-item.active .tree-toggle { color: #fff; }
        .item-tree .tree-link { flex: 1 1 auto; color: inherit; text-decoration: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .item-tree .tree-toggle, .item-tree .tree-toggle-placeholder { flex: 0 0 1.25rem; width: 1.25rem; height: 1.25rem; display: inline-flex; align-items: center; justify-content: center; }
        .item-tree .tree-toggle { border: 0; background: transparent; padding: 0; color: var(--tblr-secondary, #6c757d); border-radius: .25rem; }
        .item-tree .tree-toggle:hover { background: var(--tblr-border-color, #e0e6ee); }
        .item-tree .tree-toggle svg { transition: transform .15s ease; }
        .item-tree .tree-toggle.open svg { transform: rotate(90deg); }
    </style>
    <script>
    (function () {
        var treeRoot = document.querySelector('.item-tree');
        if (treeRoot) {
            treeRoot.addEventListener('click', function (e) {
                var t = e.target.closest('.tree-toggle');
                if (!t) return;
                e.preventDefault();
                var li = t.closest('.tree-node');
                var childUl = li ? li.querySelector(':scope > .tree-children') : null;
                if (!childUl) return;
                var nowOpen = childUl.classList.toggle('d-none') === false;
                t.classList.toggle('open', nowOpen);
                t.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
            });
        }
    })();
    </script>
}
