@using GONES.Web.Models
@model List<GoodsApplyListRow>
@{
    ViewBag.Title = "要货计划单维护";
    var billCount = Model.Select(r => r.InterId).Distinct().Count();
    var hasRows = Model.Count > 0;
    var filter = (Dictionary<string, string>)ViewBag.Filter;
    // status badge helper
    Func<short, string> badge = s => s == 0 ? "bg-secondary-lt" : (s == 1 ? "bg-green-lt" : "bg-azure-lt");
    Func<short, string> statusText = s => s == 0 ? "未审核" : (s == 1 ? "已审核" : "已完成");
    // 与服务端 W1 硬拦（仓库数据权限）同源的提示语。
    var outOfScopeTitle = "该单据包含不属于您管理仓库的明细，禁止操作";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto d-print-none">
            <a class="btn btn-primary" href="/GoodsApply/Create">新增要货计划单</a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-0">单据日期</label>
                <div class="d-flex align-items-center gap-1">
                    <input type="date" class="form-control form-control-sm" name="dateFrom" value="@filter["dateFrom"]" />
                    <span class="text-secondary">~</span>
                    <input type="date" class="form-control form-control-sm" name="dateTo" value="@filter["dateTo"]" />
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">单据编号</label>
                <input type="text" class="form-control form-control-sm" name="billNo" value="@filter["billNo"]" placeholder="模糊匹配" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">查询</button>
                <a class="btn btn-sm btn-outline-secondary" href="/GoodsApply">清空</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">要货计划单列表</h3>
        <div class="card-actions">
            <span class="badge bg-azure-lt">本页 @billCount 单 / @Model.Count 行</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-sm">
            <thead>
                <tr>
                    <th class="w-1">BOMID</th>
                    <th>单据日期</th>
                    <th>单据状态</th>
                    <th>单据编号</th>
                    <th>申请部门</th>
                    <th>申请人</th>
                    <th>产品分类</th>
                    <th>产品名称</th>
                    <th>规格型号</th>
                    <th>单位</th>
                    <th class="text-end">申请数量</th>
                    <th class="text-end">完成数量</th>
                    <th class="text-end">未完成数量</th>
                    <th>完成日期</th>
                    <th>备注</th>
                    <th class="w-1">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!hasRows)
                {
                    <tr><td colspan="16" class="text-center text-secondary py-4">暂无符合条件的要货计划单。</td></tr>
                }
                @{
                    var prevInterId = -1;
                }
                @foreach (var r in Model)
                {
                    var remain = (r.Qty ?? 0m) - (r.FetchNum ?? 0m);
                    var newBill = r.InterId != prevInterId;
                    prevInterId = r.InterId;
                    <tr class="@(newBill ? "border-top-2" : "")">
                        <td class="text-secondary">@r.BomId</td>
                        <td class="text-secondary">@r.Date?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (r.FirstOfBill)
                            {
                                <span class="badge @badge(r.Status)">@statusText(r.Status)</span>
                            }
                        </td>
                        <td>@(r.FirstOfBill ? r.BillNo : "")</td>
                        <td>@(r.FirstOfBill ? r.DeptName : "")</td>
                        <td>@(r.FirstOfBill ? r.EmpName : "")</td>
                        <td class="text-secondary">@r.Cplb</td>
                        <td>@r.Cpjc</td>
                        <td class="text-secondary">@r.Cpgg</td>
                        <td class="text-secondary">@r.UnitName</td>
                        <td class="text-end">@string.Format("{0:0.00}", r.Qty ?? 0m)</td>
                        <td class="text-end">@string.Format("{0:0.00}", r.FetchNum ?? 0m)</td>
                        <td class="text-end">@string.Format("{0:0.00}", remain)</td>
                        <td class="text-secondary">@r.FetchDate?.ToString("yyyy-MM-dd")</td>
                        <td class="text-secondary">@(string.IsNullOrEmpty(r.Note) ? r.Explanation : r.Note)</td>
                        <td class="text-nowrap">
                            @if (r.FirstOfBill && r.Status == 0 && !r.CanModify)
                            {
                                @* W1：明细未全部属于本仓库 ⇒ 只给查看。 *@
                                <a class="btn btn-sm btn-outline-info" href="/GoodsApply/Details/@r.InterId">查看</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="@outOfScopeTitle">修改</button>
                                <button type="button" class="btn btn-sm btn-outline-success" disabled title="@outOfScopeTitle">审核</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled title="@outOfScopeTitle">删除</button>
                            }
                            else if (r.FirstOfBill && r.Status == 0)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="/GoodsApply/Edit/@r.InterId">修改</a>
                                <form method="post" action="/GoodsApply/Audit/@r.InterId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            data-confirm data-confirm-title="审核确认"
                                            data-confirm-message="确认审核单据 [@r.BillNo] 吗？"
                                            data-confirm-yes="审核" data-confirm-yes-class="btn-primary">审核</button>
                                </form>
                                <form method="post" action="/GoodsApply/Delete/@r.InterId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm data-confirm-title="删除确认"
                                            data-confirm-message="确认删除单据 [@r.BillNo] 吗？此操作不可恢复！"
                                            data-confirm-yes="删除">删除</button>
                                </form>
                            }
                            else if (r.FirstOfBill && r.Status == 1)
                            {
                                <a class="btn btn-sm btn-outline-info" href="/GoodsApply/Details/@r.InterId">查看</a>
                                @if (!r.CanModify)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" disabled title="@outOfScopeTitle">反审核</button>
                                }
                                else if (r.CanUnAudit)
                                {
                                    <form method="post" action="/GoodsApply/UnAudit/@r.InterId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                data-confirm data-confirm-title="反审核确认"
                                                data-confirm-message="确认反审核单据 [@r.BillNo] 吗？"
                                                data-confirm-yes="反审核" data-confirm-yes-class="btn-primary">反审核</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" disabled
                                            title="要货单存在已导入生产单的产品，禁止反审核">反审核</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pager", (GONES.Web.Models.PagerViewModel)ViewBag.Pager)
</div>
