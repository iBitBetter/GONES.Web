@model System.Collections.Generic.List<GONES.Model.Pg.t_ERP_ShopInfo>
@{
    ViewBag.Title = "店铺管理";
}
<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            <a class="btn btn-primary" href="/SysShop/Create">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                    <path d="M12 5l0 14" /><path d="M5 12l14 0" />
                </svg>
                新建
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>店铺编号</th>
                    <th>店铺名称</th>
                    <th>联系电话</th>
                    <th>QQ号码</th>
                    <th>联系地址</th>
                    <th>每次下载</th>
                    <th>自动下载</th>
                    <th>启用</th>
                    <th class="w-1">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.ShopNumber</td>
                        <td>@s.ShopName</td>
                        <td>@s.Phone</td>
                        <td>@s.QQ</td>
                        <td>@s.Address</td>
                        <td>@s.OrderCount</td>
                        <td>
                            @if (s.IsAutoDown == true)
                            {
                                <span class="badge bg-success">是</span>
                            }
                            else
                            {
                                <span class="badge">否</span>
                            }
                        </td>
                        <td>
                            @if (s.IsEnable == true)
                            {
                                <span class="badge bg-success">启用</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">禁用</span>
                            }
                        </td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/SysShop/Edit/@s.ID">修改</a>
                                <form asp-action="Delete" asp-route-id="@s.ID" method="post" class="d-inline"
                                      data-confirm=""
                                      data-confirm-title="删除店铺"
                                      data-confirm-message="确定删除店铺“@s.ShopName”吗？"
                                      data-confirm-yes="确定删除"
                                      data-confirm-yes-class="btn-danger">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-secondary py-5">
            暂无店铺数据。
        </div>
    }
    @await Html.PartialAsync("_Pager", (GONES.Web.Models.PagerViewModel)ViewBag.Pager)
</div>
