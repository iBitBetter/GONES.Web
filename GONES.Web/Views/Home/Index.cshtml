@model GONES.Web.Models.HomeViewModel
@{
    ViewBag.Title = "控制台首页";
    // 期间页签：文字 / Tabler 配色
    var tabs = new[] {
        ("day", "日", "danger"), ("week", "周", "warning"),
        ("month", "月", "success"), ("quarter", "季", "primary"), ("year", "年", "info")
    };
    string badgeCls = Model.PeriodKey switch {
        "week" => "bg-warning", "month" => "bg-success", "quarter" => "bg-primary", "year" => "bg-info", _ => "bg-danger"
    };
}
<style>
    /* 首页样式全部限定在 .home-page 内，避免污染全局 */
    .home-page .stat-tile { background:#f6f8fb; border-radius:8px; padding:12px 14px; height:100%; }
    .home-page .stat-tile .lbl { font-size:13px; color:#61748f; display:flex; align-items:center; gap:8px; }
    .home-page .stat-tile .bdg { font-size:11px; padding:1px 7px; border-radius:9px; color:#fff; font-weight:600; }
    .home-page .stat-tile .val { font-size:26px; font-weight:800; line-height:1.25; color:#1f2b3d; font-variant-numeric:tabular-nums; margin-top:2px; }
    .home-page .stat-tile .sub { font-size:12px; color:#8898aa; margin-top:1px; font-variant-numeric:tabular-nums; }
    .home-page .ptab { min-width:38px; text-align:center; border-radius:6px; padding:3px 10px; font-size:13px; font-weight:600; color:#fff; display:inline-block; opacity:.45; }
    .home-page .ptab:hover { opacity:.75; text-decoration:none; color:#fff; }
    .home-page .ptab.active { opacity:1; }
    .home-page .qk-tile { background:#f6f8fb; border-radius:8px; padding:16px 6px 12px; text-align:center; display:block; color:#4b586c; text-decoration:none; transition:background .15s, transform .15s; height:100%; }
    .home-page .qk-tile:hover { background:#e8eef7; color:#206bc4; transform:translateY(-2px); text-decoration:none; }
    .home-page .qk-tile svg { width:30px; height:30px; stroke-width:1.6; }
    .home-page .qk-tile .t { font-size:13px; margin-top:8px; font-weight:600; }
    .home-page .card-title .icon { color:#206bc4; }
</style>

<div class="container-xl home-page">
    <div class="text-secondary small mb-2" style="margin-top:-10px;text-align:left;">
        欢迎回来，@Model.UserName！@(Model.IsAdmin ? "您以管理员身份登录，可进行全部配置与维护操作。" : "您以普通用户身份登录，部分功能受角色权限限制。")
    </div>

    <div class="row row-deck row-cards">
        <!-- 左：生产数据统计 -->
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header py-2">
                    <h3 class="card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/><path d="M12 17h.01"/></svg>
                        生产数据统计
                    </h3>
                    <div class="card-actions">
                        @foreach (var (key, txt, color) in tabs)
                        {
                            <a class="ptab bg-@color @(Model.PeriodKey == key ? "active" : "")" href="/?p=@key">@txt</a>
                        }
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">入库数量 <span class="bdg @badgeCls">@Model.BadgeText</span></div>
                                <div class="val">@Model.InQty.ToString("N0")</div>
                                <div class="sub">其中生产入库 @Model.InQtyProductIn.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">出库数量 <span class="bdg @badgeCls">@Model.BadgeText</span></div>
                                <div class="val">@Model.OutQty.ToString("N0")</div>
                                <div class="sub">其中领料出库 @Model.OutQtyPick.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">单据数 <span class="bdg @badgeCls">@Model.BadgeText</span></div>
                                <div class="val">@Model.BillCount.ToString("N0")</div>
                                <div class="sub">入库单 @Model.InBillCount / 出库单 @Model.OutBillCount</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">报损 <span class="bdg @badgeCls">@Model.BadgeText</span></div>
                                <div class="val">@Model.LossQty.ToString("N0")<span class="sub ms-1">件</span></div>
                                <div class="sub">金额 ¥@Model.LossAmount.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">待处理要货 <span class="bdg bg-orange">实时</span></div>
                                <div class="val">@Model.PendingApply.ToString("N0")</div>
                                <div class="sub">未审核要货申请单</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-tile">
                                <div class="lbl">库存总量 <span class="bdg bg-orange">实时</span></div>
                                <div class="val">@Model.StockTotalQty.ToString("N0")</div>
                                <div class="sub">共 @Model.StockKinds 种物料有库存</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右：快捷入口（按角色 + 账号实际菜单权限过滤，无权限的入口不显示） -->
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header py-2">
                    <h3 class="card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="4" y="5" width="6" height="6" rx="1"/><rect x="14" y="5" width="6" height="6" rx="1"/><rect x="4" y="13" width="6" height="6" rx="1"/><rect x="14" y="13" width="6" height="6" rx="1"/></svg>
                        快捷入口
                        <span class="badge badge-sm bg-secondary-lt ms-1">@(Model.IsAdmin ? "管理员" : "普通用户")</span>
                    </h3>
                </div>
                <div class="card-body p-2">
                    <div class="row g-2">
                        @foreach (var lk in Model.Links)
                        {
                            <div class="col-3">
                                <a class="qk-tile gones-tab-link" href="@lk.Url" data-tab-title="@lk.Title"
                                   onclick="var g = window.parent && window.parent.GonesTabs; if (g) { g.open(this.getAttribute('href'), this.getAttribute('data-tab-title') || ''); return false; } return true;">
                                    @QkIcon(lk.Icon)
                                    <div class="t">@lk.Title</div>
                                </a>
                            </div>
                        }
                        @if (Model.Links.Count == 0)
                        {
                            <div class="col-12 text-secondary small text-center py-4">当前账号暂无可用的快捷入口</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 下：报表统计 -->
        <div class="col-12">
            <div class="card">
                <div class="card-header py-2">
                    <h3 class="card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 19h16"/><path d="M4 15l4 -6l4 2l4 -5l4 3"/></svg>
                        报表统计
                        <span class="text-secondary small ms-1">近 30 天出入库 / 报损数量趋势（已审）</span>
                    </h3>
                </div>
                <div class="card-body pb-2">
                    <div id="homeChart" style="width:100%;height:300px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    // 快捷入口内联 SVG（Tabler outline 风格，键 → 图标）
    static Microsoft.AspNetCore.Html.IHtmlContent QkIcon(string key)
    {
        string body = key switch
        {
            "box" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M12 3l8 4.5v9l-8 4.5l-8 -4.5v-9l8 -4.5\"/><path d=\"M12 12l8 -4.5\"/><path d=\"M12 12v9\"/><path d=\"M12 12l-8 -4.5\"/>",
            "inbox" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M4 7l8 -4l8 4v10l-8 4l-8 -4z\"/><path d=\"M4 7l8 4l8 -4\"/><path d=\"M12 11v10\"/>",
            "truck" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><circle cx=\"7\" cy=\"17\" r=\"2\"/><circle cx=\"17\" cy=\"17\" r=\"2\"/><path d=\"M17 17h1a1 1 0 0 0 1 -1v-5l-3 -3h-3v9\"/><path d=\"M5 17h-2v-11h9v11\"/><path d=\"M9 20l2 -3l2 3\"/>",
            "users" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2\"/><path d=\"M16 3.9a4 4 0 0 1 0 7.75\"/><path d=\"M21 21v-2a4 4 0 0 0 -3 -3.85\"/>",
            "chart" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M4 19h16\"/><path d=\"M4 15l4 -6l4 2l4 -5l4 3\"/>",
            "database" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/><path d=\"M4 6v12a8 3 0 0 0 16 0v-12\"/><path d=\"M4 12a8 3 0 0 0 16 0\"/>",
            "dashboard" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><rect x=\"4\" y=\"4\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"13\" y=\"4\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"13\" y=\"12\" width=\"7\" height=\"8\" rx=\"1\"/><rect x=\"4\" y=\"16\" width=\"7\" height=\"4\" rx=\"1\"/>",
            "settings" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M4 8h10\"/><circle cx=\"17\" cy=\"8\" r=\"2\"/><path d=\"M20 16h-10\"/><circle cx=\"7\" cy=\"16\" r=\"2\"/>",
            "cart" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><circle cx=\"6\" cy=\"19\" r=\"2\"/><circle cx=\"17\" cy=\"19\" r=\"2\"/><path d=\"M17 17h-11l-1 -13h-2\"/><path d=\"M6 5l14 1l-1 7h-12\"/>",
            "check" => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M20 11a8.1 8.1 0 1 0 -2.5 6\"/><path d=\"M20 5v6h-6\"/><path d=\"M9 12l2 2l4 -4\"/>",
            _ => "<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><rect x=\"5\" y=\"5\" width=\"14\" height=\"14\" rx=\"2\"/>"
        };
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{body}</svg>");
    }
}

<script src="/vendor/echarts/echarts.min.js"></script>
<script>
    (function () {
        const el = document.getElementById('homeChart');
        if (!el || typeof echarts === 'undefined') return;
        const D = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            Model.TrendDates, Model.TrendIn, Model.TrendOut, Model.TrendLoss
        }).Replace("</", "<\\/"));
        echarts.init(el).setOption({
            backgroundColor: 'transparent',
            tooltip: { trigger: 'axis' },
            legend: { data: ['入库', '出库', '报损'], top: 0, textStyle: { color: '#4b586c' } },
            grid: { left: 60, right: 20, top: 36, bottom: 30 },
            xAxis: { type: 'category', boundaryGap: false, data: D.TrendDates,
                axisLine: { lineStyle: { color: '#dce1e8' } }, axisLabel: { color: '#8898aa' } },
            yAxis: { type: 'value', axisLabel: { color: '#8898aa' },
                splitLine: { lineStyle: { color: '#eef1f6' } } },
            series: [
                { name: '入库', type: 'line', smooth: true, symbol: 'circle', symbolSize: 7,
                  itemStyle: { color: '#206bc4', borderColor: '#fff', borderWidth: 1.5 }, lineStyle: { width: 2.5 }, data: D.TrendIn },
                { name: '出库', type: 'line', smooth: true, symbol: 'circle', symbolSize: 7,
                  itemStyle: { color: '#2fb344', borderColor: '#fff', borderWidth: 1.5 }, lineStyle: { width: 2.5 }, data: D.TrendOut },
                { name: '报损', type: 'line', smooth: true, symbol: 'circle', symbolSize: 7,
                  itemStyle: { color: '#d63939', borderColor: '#fff', borderWidth: 1.5 }, lineStyle: { width: 2, type: 'dashed' }, data: D.TrendLoss }
            ]
        });
    })();
</script>
